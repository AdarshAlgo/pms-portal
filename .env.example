FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=pms-default-production-key-change-me
DATABASE_URL=sqlite:///instance/pms.db
# For PostgreSQL on Render: DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Flask-Mail (SMTP) Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="PMS Portal <noreply@university.edu>"
